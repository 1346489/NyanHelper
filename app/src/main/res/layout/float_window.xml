<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/float_panel"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:background="@drawable/bg_float_panel">

    <!-- 特效层（雪花/流星画在这里）-->
    <com.moe.nyanhelper.SnowMeteorView
        android:id="@+id/effectView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 面板内容：猫头 + 3 选项 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp"
        android:gravity="center">

        <TextView
            android:id="@+id/float_ball"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="🐱"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3">

            <TextView android:id="@+id/tabFeatures"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="功能"
                android:textSize="10sp" android:gravity="center"
                android:padding="2dp"/>

            <TextView android:id="@+id/tabSettings"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="设置"
                android:textSize="10sp" android:gravity="center"
                android:padding="2dp"/>

            <TextView android:id="@+id/tabTheme"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="主题"
                android:textSize="10sp" android:gravity="center"
                android:padding="2dp"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
