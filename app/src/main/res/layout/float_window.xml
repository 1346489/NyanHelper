<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/float_panel"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_white"
        android:padding="14dp"
        android:elevation="8dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本喵设置"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sw_add_nya"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="结尾加喵字"
            android:textSize="13sp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#EEE" android:layout_marginVertical="4dp" />

        <Switch
            android:id="@+id/sw_me"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="我 → 本喵"
            android:textSize="13sp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#EEE" android:layout_marginVertical="4dp" />

        <Switch
            android:id="@+id/sw_you"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="你 → 主人"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/float_ball"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_ball_pink">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/nyan_avatar"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>
