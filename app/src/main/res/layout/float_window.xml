<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="wrap_content">

    <!-- 特效绘制层（放在最底层，覆盖整个悬浮窗区域） -->
    <FrameLayout
        android:id="@+id/effectLayer"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@android:color/transparent" />

    <!-- 悬浮球/面板（半透明粉色） -->
    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_dark_pink_bg"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ballIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_ball"
            android:scaleType="centerCrop"
            android:background="@drawable/ball_circle"
            android:contentDescription="本喵悬浮球" />

        <!-- 3 个选项：功能 / 设置 / 主题 -->
        <TextView
            android:id="@+id/tabFeatures"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:text="功能"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/panel_item_bg" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="设置"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/panel_item_bg" />

        <TextView
            android:id="@+id/tabTheme"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="主题"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/panel_item_bg" />

        <TextView
            android:id="@+id/tabHide"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="隐藏悬浮"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/panel_item_bg" />

    </LinearLayout>

</FrameLayout>
