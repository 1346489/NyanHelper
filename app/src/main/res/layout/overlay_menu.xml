<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- Effect container (snow/meteor) - behind everything -->
    <FrameLayout
        android:id="@+id/effect_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main menu window -->
    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="480dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_window"
        android:clipChildren="true">

        <!-- Title Bar with X button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:background="@color/pink_primary">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本喵助手"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="398×258"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="@android:color/transparent"
                android:contentDescription="关闭" />
        </LinearLayout>

        <!-- Content Area with sidebar menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left Menu -->
            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/overlay_card"
                android:padding="8dp">

                <TextView
                    android:id="@+id/menu_announcement"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="公告"
                    android:textSize="13sp"
                    android:textColor="@color/overlay_text"
                    android:gravity="center"
                    android:background="@drawable/bg_menu_item"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/menu_functions"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="功能"
                    android:textSize="13sp"
                    android:textColor="@color/overlay_text"
                    android:gravity="center"
                    android:background="@drawable/bg_menu_item"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/menu_settings"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置"
                    android:textSize="13sp"
                    android:textColor="@color/overlay_text"
                    android:gravity="center"
                    android:background="@drawable/bg_menu_item"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/menu_control"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="控制"
                    android:textSize="13sp"
                    android:textColor="@color/overlay_text"
                    android:gravity="center"
                    android:background="@drawable/bg_menu_item"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/menu_theme"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="主题"
                    android:textSize="13sp"
                    android:textColor="@color/overlay_text"
                    android:gravity="center"
                    android:background="@drawable/bg_menu_item" />

            </LinearLayout>

            <!-- Right Content -->
            <FrameLayout
                android:id="@+id/content_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/overlay_bg"
                android:padding="12dp">

                <!-- ===== PAGE: ANNOUNCEMENT ===== -->
                <ScrollView
                    android:id="@+id/page_announcement"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="公告"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/overlay_text"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/announcement_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="13sp"
                                android:textColor="@color/overlay_text"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/announcement_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="13sp"
                                android:textColor="@color/overlay_subtext"
                                android:lineSpacingExtra="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- ===== PAGE: FUNCTIONS ===== -->
                <ScrollView
                    android:id="@+id/page_functions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="功能"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/overlay_text"
                            android:layout_marginBottom="12dp" />

                        <!-- Switch 1: Add Miao -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/func_add_miao"
                                android:textSize="13sp"
                                android:textColor="@color/overlay_text" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_add_miao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/pink_accent"
                                android:trackTint="@color/pink_light" />
                        </LinearLayout>

                        <!-- Switch 2: Replace Me -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/func_replace_me"
                                android:textSize="13sp"
                                android:textColor="@color/overlay_text" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_replace_me"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/pink_accent"
                                android:trackTint="@color/pink_light" />
                        </LinearLayout>

                        <!-- Switch 3: Replace You -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/func_replace_you"
                                android:textSize="13sp"
                                android:textColor="@color/overlay_text" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_replace_you"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/pink_accent"
                                android:trackTint="@color/pink_light" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="以上功能通过无障碍权限使用"
                            android:textSize="11sp"
                            android:textColor="@color/overlay_subtext"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </ScrollView>

                <!-- ===== PAGE: SETTINGS (Snow/Meteor) ===== -->
                <ScrollView
                    android:id="@+id/page_settings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="设置"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/overlay_text"
                            android:layout_marginBottom="12dp" />

                        <!-- Snow Switch -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/setting_snow"
                                android:textSize="14sp"
                                android:textColor="@color/overlay_text" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_snow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/pink_accent"
                                android:trackTint="@color/pink_light" />
                        </LinearLayout>

                        <!-- Meteor Switch -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/setting_meteor"
                                android:textSize="14sp"
                                android:textColor="@color/overlay_text" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_meteor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/pink_accent"
                                android:trackTint="@color/pink_light" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="雪花和流星雨只能在悬浮窗内掉落"
                            android:textSize="11sp"
                            android:textColor="@color/overlay_subtext"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </ScrollView>

                <!-- ===== PAGE: CONTROL ===== -->
                <ScrollView
                    android:id="@+id/page_control"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="控制"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/overlay_text"
                            android:layout_marginBottom="12dp" />

                        <!-- Volume Hide Switch (default ON) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:backgroundTint="#FF3A3A5C"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/control_volume_hide"
                                    android:textSize="14sp"
                                    android:textColor="@color/overlay_text" />

                                <androidx.appcompat.widget.SwitchCompat
                                    android:id="@+id/switch_volume_hide"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:thumbTint="@color/pink_accent"
                                    android:trackTint="@color/pink_light" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/control_volume_hide_desc"
                                android:textSize="11sp"
                                android:textColor="@color/overlay_subtext"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- ===== PAGE: THEME ===== -->
                <ScrollView
                    android:id="@+id/page_theme"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="主题"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/overlay_text"
                            android:layout_marginBottom="12dp" />

                        <!-- Background Color -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_bg_color"
                            android:textSize="13sp"
                            android:textColor="@color/overlay_text"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <View
                                android:id="@+id/bg_color_1"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_theme_color_option"
                                android:backgroundTint="#FFFFFFFF" />

                            <View
                                android:id="@+id/bg_color_2"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_theme_color_option"
                                android:backgroundTint="#FFFFE4EC" />

                            <View
                                android:id="@+id/bg_color_3"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_theme_color_option"
                                android:backgroundTint="#FF2D2D30" />
                        </LinearLayout>

                        <!-- Text Color (different options) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_text_color"
                            android:textSize="13sp"
                            android:textColor="@color/overlay_text"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">

                            <View
                                android:id="@+id/text_color_1"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_theme_color_option"
                                android:backgroundTint="#FF000000" />

                            <View
                                android:id="@+id/text_color_2"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_theme_color_option"
                                android:backgroundTint="#FFFFFFFF" />

                            <View
                                android:id="@+id/text_color_3"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_theme_color_option"
                                android:backgroundTint="#FF8B008B" />
                        </LinearLayout>

                        <!-- Reset Button -->
                        <Button
                            android:id="@+id/btn_reset_theme"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="@string/theme_reset"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_pink_button" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="默认: 白色背景 + 黑色文字"
                            android:textSize="11sp"
                            android:textColor="@color/overlay_subtext"
                            android:gravity="center"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </ScrollView>

            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
