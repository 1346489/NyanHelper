<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 粒子层（雪花/流星雨，在悬浮窗内掉落） -->
    <com.benmao.assistant.ParticleView
        android:id="@+id/particle_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/menu_root"
        android:layout_width="340dp"
        android:layout_height="480dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/menu_bg"
        android:elevation="8dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/pink_primary"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 左侧菜单 -->
            <LinearLayout
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/nav_announce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="公告"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/nav_function"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="功能"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/nav_settings2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/nav_control"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="控制"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/nav_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="主题"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 右侧内容 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="16dp">

                <!-- 公告页 -->
                <LinearLayout
                    android:id="@+id/page_announce"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. 此应用公益，不要被骗了"
                        android:textSize="15sp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. 功能开关通过无障碍权限生效"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- 功能页 -->
                <LinearLayout
                    android:id="@+id/page_function"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <SwitchCompat
                        android:id="@+id/switch_add_meow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="始终在结尾添加「喵」字" />

                    <SwitchCompat
                        android:id="@+id/switch_replace_me"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="将「我」自动换为「本喵」"
                        android:layout_marginTop="12dp" />

                    <SwitchCompat
                        android:id="@+id/switch_replace_you"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="将「你」自动换为「主人」"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="（以上三项通过无障碍权限使用）"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:layout_marginTop="16dp" />
                </LinearLayout>

                <!-- 设置页（雪花/流星雨，互斥） -->
                <LinearLayout
                    android:id="@+id/page_settings2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <SwitchCompat
                        android:id="@+id/switch_snow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="雪花" />

                    <SwitchCompat
                        android:id="@+id/switch_meteor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="流星雨"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="（雪花与流星雨仅可在悬浮窗内掉落，二者只能开一个）"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:layout_marginTop="16dp" />
                </LinearLayout>

                <!-- 控制页 -->
                <LinearLayout
                    android:id="@+id/page_control"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <SwitchCompat
                        android:id="@+id/switch_volume_hide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="音量键隐藏（默认开启）" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="音量上：菜单变回菜单 / 音量下：关闭菜单变回悬浮球"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:layout_marginTop="16dp" />
                </LinearLayout>

                <!-- 主题页 -->
                <LinearLayout
                    android:id="@+id/page_theme"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="背景颜色"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/group_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <View
                            android:id="@+id/color_bg_white"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_white" />
                        <View
                            android:id="@+id/color_bg_pink"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_pink"
                            android:layout_marginStart="12dp" />
                        <View
                            android:id="@+id/color_bg_dark"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_dark"
                            android:layout_marginStart="12dp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="文字颜色"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp" />

                    <RadioGroup
                        android:id="@+id/group_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <View
                            android:id="@+id/color_text_black"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_black" />
                        <View
                            android:id="@+id/color_text_white"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_white"
                            android:layout_marginStart="12dp" />
                        <View
                            android:id="@+id/color_text_purple"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_purple"
                            android:layout_marginStart="12dp" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/btn_reset_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="恢复默认主题（白底黑字）"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/btn_green"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
FrameLayout>
