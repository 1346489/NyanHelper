<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_float_panel"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/avatar"
            android:background="@drawable/bg_circle_white"
            android:padding="3dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="喵化设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D64F88"
            android:paddingStart="10dp" />

        <ImageButton
            android:id="@+id/closePanel"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_white"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#D64F88" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFD1DC"
        android:layout_marginVertical="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="结尾始终添加喵"
            android:textColor="#6B3952"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switchTail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="把「我」改成「本喵」"
            android:textColor="#6B3952"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switchMe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="把「你」改成「主人」"
            android:textColor="#6B3952"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switchYou"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
