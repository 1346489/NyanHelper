<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_theme_sakura">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnSakura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme_sakura"/>

    <Button
        android:id="@+id/btnMint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme_mint"/>

    <Button
        android:id="@+id/btnStarry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme_starry"/>

</LinearLayout>
