<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/bg_main">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/avatar_main"
        android:scaleType="centerCrop"
        android:background="@drawable/avatar_frame"
        android:contentDescription="应用头像" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="本喵助手"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FF5C8D"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="让文字变得可爱喵~"
        android:textSize="14sp"
        android:textColor="#88553A4A"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvFloatStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ 悬浮窗权限未开启"
            android:textSize="14sp"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/tvAccessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ 无障碍服务未开启"
            android:textSize="14sp"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚪ 悬浮窗服务未运行"
            android:textSize="14sp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnShowFloat"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="开启悬浮窗"
        android:textSize="16sp"
        android:backgroundTint="#FF8FBC"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnOpenAccess"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="去开启无障碍服务"
        android:textSize="16sp"
        android:backgroundTint="#FFB6D0"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnHideFloat"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="隐藏悬浮窗"
        android:textSize="16sp"
        android:backgroundTint="#DDC7FF"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

    <!-- 三个入口：功能 / 设置 / 主题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnFeatures"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="功能"
            android:backgroundTint="#FF9FCC"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:backgroundTint="#B4E7CE"
            android:textColor="#FFFFFF"
            android:layout_marginHorizontal="6dp" />

        <Button
            android:id="@+id/btnTheme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="主题"
            android:backgroundTint="#C5B4FF"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
