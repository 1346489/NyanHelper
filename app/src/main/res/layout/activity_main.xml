<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/nyan_avatar"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_avatar_circle"
            android:padding="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本喵助手"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="让文字变得可爱喵~"
            android:textSize="14sp"
            android:textColor="#888"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvFloatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❌ 悬浮窗权限未开启"
                android:textSize="14sp"
                android:paddingVertical="6dp" />

            <TextView
                android:id="@+id/tvAccessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❌ 无障碍服务未开启"
                android:textSize="14sp"
                android:paddingVertical="6dp" />

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚪ 悬浮窗服务未运行"
                android:textSize="14sp"
                android:paddingVertical="6dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFloatToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="开启悬浮窗"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnAccessOpen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="去开启无障碍服务"
            android:textSize="16sp"
            android:textColor="@color/primary"
            android:backgroundTint="#FFF0F5"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="刷新状态"
            android:textSize="16sp"
            android:textColor="#888"
            android:backgroundTint="#F5F5F5"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
