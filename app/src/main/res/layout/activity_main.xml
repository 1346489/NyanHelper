<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 大背景图 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_main"
        android:scaleType="centerCrop" />

    <!-- 半透明白遮罩 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF" />

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/appAvatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/avatar"
            android:scaleType="fitCenter"
            android:layout_marginTop="36dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本喵助手"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#D64F83"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_pink"
            android:padding="16dp"
            android:textColor="#885566"
            android:textSize="15sp"
            android:layout_marginTop="22dp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnFloat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="开启悬浮窗"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:backgroundTint="#F48FB1"
            android:layout_marginTop="22dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="打开无障碍权限"
            android:textColor="#D64F83"
            android:textSize="15sp"
            android:backgroundTint="#FFD6E2"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="打开悬浮窗权限"
            android:textColor="#D64F83"
            android:textSize="15sp"
            android:backgroundTint="#FFD6E2"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</FrameLayout>
