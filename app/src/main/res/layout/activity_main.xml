<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/nyan_avatar"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name"
            android:background="@drawable/bg_avatar_circle"
            android:padding="6dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FF5C8D"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textSize="15sp"
            android:textColor="#553344"
            android:background="@drawable/bg_card_white"
            android:padding="14dp"
            android:layout_marginTop="14dp"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnFloat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_show_float"
            android:layout_marginTop="14dp"
            android:backgroundTint="#FF8FBC"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_access"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFB6D0"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnHide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_hide_float"
            android:layout_marginTop="8dp"
            android:backgroundTint="#DDC7FF"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
