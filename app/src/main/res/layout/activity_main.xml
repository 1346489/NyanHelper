<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/bg_theme_sakura">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/avatar_main"
        android:scaleType="centerCrop"
        android:background="@drawable/ball_circle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="本喵助手"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#5B2740" />

    <TextView
        android:id="@+id/tvService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="○ 服务未运行"
        android:textSize="14sp"
        android:textColor="#999999" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnFeatures"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="⚙️ 功能"
            android:textSize="18sp"
            android:textColor="#5B2740"
            android:background="@drawable/panel_item_bg" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="🔧 设置"
            android:textSize="18sp"
            android:textColor="#5B2740"
            android:background="@drawable/panel_item_bg" />

        <TextView
            android:id="@+id/btnTheme"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="🎨 主题"
            android:textSize="18sp"
            android:textColor="#5B2740"
            android:background="@drawable/panel_item_bg" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="🚀 开启悬浮球"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/panel_side_bg" />

    </LinearLayout>

</LinearLayout>
